# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis no projeto.

# Postgres (na Vercel: Storage > Neon cria e preenche sozinho)
DATABASE_URL=postgres://postgres:portfolio@localhost:5447/portfolio

# Senha do /admin: node scripts/hash-senha.mjs "sua senha"
ADMIN_PASSWORD_HASH=

# Assina o cookie de sessão do /admin: openssl rand -hex 32
SESSION_SECRET=


# Imagens do blog (na Vercel: Storage > Blob preenche sozinho). Vazio = salva em public/uploads (só local).
BLOB_READ_WRITE_TOKEN=

# Endereço público do site, para links e compartilhamento
NEXT_PUBLIC_SITE_URL=https://leon-moreira.vercel.app
